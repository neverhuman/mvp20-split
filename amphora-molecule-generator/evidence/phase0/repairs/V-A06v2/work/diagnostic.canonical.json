{
  "attack_on_convention_choice": {
    "question": "Is the active-hydrogen (active_NH) convention genuinely the product-relevant one for epoxy-amine stoichiometry, vs the amine-centre (nitrogen-atom) convention?",
    "refutation_criterion": "Would REFUTE if a published, citable, epoxy-formulation-authoritative source defines AHEW, mix-ratio phr, or Flory-Stockmayer network functionality f in terms of nitrogen-atom count rather than N-H hydrogen count for primary/secondary amine hardeners.",
    "sources_checked": [
      {
        "citation": "Lee, H. & Neville, K. 1967, Handbook of Epoxy Resins, McGraw-Hill (LCCN 66-23992)",
        "finding": "Defines amine hydrogen equivalent weight (AHEW) as MW / (number of active hydrogens), explicitly hydrogen-count based, not nitrogen-count based; this is the basis already cited by the module's own in-tree reference file."
      },
      {
        "citation": "Ellis, B. (ed.) 1993, Chemistry and Technology of Epoxy Resins, Blackie/Chapman & Hall, ISBN 978-0-7514-0095-4, ch.3",
        "finding": "Stoichiometric mix ratio for amine curing agents is computed from the amine hydrogen equivalent weight (active-H basis); a tertiary amine (0 active H) can be a catalytic accelerator present in a formulation without contributing to the crosslink stoichiometry despite being a nitrogen centre -- consistent with active-H, inconsistent with amine-centre."
      },
      {
        "citation": "Flory, P.J. 1953, Principles of Polymer Chemistry, Cornell Univ. Press, ch. IX",
        "finding": "Network functionality f in the Flory-Stockmayer gelation criterion is the number of INDEPENDENT reactive groups per monomer capable of forming a bond with the co-reactant -- for an amine reacting with epoxide, each N-H is one independently-reacting group, not each nitrogen atom; a tertiary N with 0 active H contributes f=0 from that centre even though it is a nitrogen atom."
      },
      {
        "citation": "ASTM D2074-07(2019) Standard Test Methods for Total, Primary, Secondary, and Tertiary Amine Values",
        "finding": "Total amine value (titration, nitrogen-basicity basis) is DELIBERATELY a distinct, separately-named quantity from AHEW/functionality in this standard -- confirming amine-centre and active-hydrogen are recognized in the standards literature as two different, non-interchangeable measurements, not competing definitions of the same thing."
      }
    ],
    "verdict_on_convention_choice": "SURVIVES: no source found that defines epoxy-amine reaction stoichiometry, AHEW, mix ratio, or Flory-Stockmayer functionality on a nitrogen-atom-count basis; all four checked sources are unanimous and internally consistent with the active-hydrogen convention. The nitrogen-atom count is the correct basis only for ASTM D2074 amine VALUE (a titration quantity), which the receipt already scopes conventionA to and does not conflate with functionality."
  },
