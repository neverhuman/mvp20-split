    "max_merkle_consistency_proof_len": 5,
    "max_merkle_inclusion_path_len": 4,
    "n_max": 12
  },
  "purpose": "Implement the published RFC 6962 Merkle-tree tamper-evident-log baseline over the shipped module's genuine runtime event-hash leaves, and quantify the audit/consistency-proof scaling trade-off against the shipped Haber-Stornetta linear hash chain.",
