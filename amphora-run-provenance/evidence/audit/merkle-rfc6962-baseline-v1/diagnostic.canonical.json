  "does_not_close": "Does NOT change the shipped Haber-Stornetta linear-chain scheme (that remains the checked runtime and satisfies the module's byte-identical-replay hypothesis). Does NOT run the live Rust runtime. A Phase-1 promotion would require implementing and re-locking a Merkle-tree provenance mode in amphora-core Rust and human dual-identity ceremony keys this cron does not hold.",
  "gates": {
    "G0_leaf_parity_and_empty_kat": true,
    "G1_merkle_roots_structural": true,
    "G2_inclusion_proofs_reconstruct_root": true,
    "G3_consistency_proofs_reconstruct_both_roots": true,
