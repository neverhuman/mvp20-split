  },
  "module": "amphora-run-provenance",
  "non_circularity": "Leaves are not fabricated: they are the runtime event_hashes built by the sibling parity oracle's PyRunArchive, and the last leaf of each archive reproduces the SHIPPED runtime event_chain_root anchor byte-exact (G0). The Merkle scheme is an alternative baseline, not the shipped scheme; roots differ from the linear-chain roots for n>0 (recorded in G1).",
  "preconditions": {
    "changes_shipped_scheme": false,
    "reused_runtime_leaves_from_parity_oracle": true,
    "runs_live_rust_runtime": false
  },
  "proof_size_comparison": {
    "claim": "Merkle inclusion/consistency proofs are O(log n); the linear chain audit is O(n). At n=12 the deepest Merkle audit path is 4 nodes vs 12 for the linear-chain suffix reveal.",
