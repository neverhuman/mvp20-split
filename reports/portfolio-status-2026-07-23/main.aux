\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Deterministic ranking of all 40 modules by composite score \(S = 25R + 20P + 15V + 15B + 10U + 10G + 5S_{\text  {readiness}}\) (see \S  \ref {sec:methodology}). Bar color encodes tier (\textbf  {S}\,dark, \textbf  {A}\,blue, \textbf  {B}\,teal, \textbf  {C}\,grey, \textbf  {D}\,amber). Right-hand annotations show the count of signed portfolio receipts per module.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ranking}{{1}{3}{Deterministic ranking of all 40 modules by composite score \(S = 25R + 20P + 15V + 15B + 10U + 10G + 5S_{\text {readiness}}\) (see \S \ref {sec:methodology}). Bar color encodes tier (\textbf {S}\,dark, \textbf {A}\,blue, \textbf {B}\,teal, \textbf {C}\,grey, \textbf {D}\,amber). Right-hand annotations show the count of signed portfolio receipts per module}{figure.caption.1}{}}
\newlabel{sec:methodology}{{}{3}{}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Left:} 65 signed receipts across 10 portfolio modules. {\ttfamily  \fontsize  {7.2}{8.4}\selectfont  amphora-molecule-property} dominates because it owns the widest property surface. \textbf  {Right:} Every Tier concentrates a different phase mix. Tier B holds 19 modules and splits between Phase-0 pipeline hooks and Pre-Phase-0 scientific modules.}}{6}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-property head-to-head. \textcolor {Green}{\bfseries  GOOD}\ Density and \(n_D\) beat their Van~Krevelen physics baselines by more than 50\%. \textcolor {Amber}{\bfseries  LEFT}\ \(\varepsilon _r\) still trails the within-context Push \#23 target because cross-corpus training absorbs a 3.5\(\times \) distribution shift (Push \#33).}}{7}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The UQ arc: parameter-only bootstrap (Push \#28) massively undercovers on external test polymers, motivating the split-conformal fix (\#29, \#30). CQR (\#32) achieves marginal over-coverage.}}{9}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Hansen space projection. The 5 canonical epoxy amines (Push \#19/\#39) cluster to the polar+H-bonding quadrant, aligning with published Hansen 2007 values for aliphatic amines. IPDA (cycloaliphatic) sits closest to non-polar solvents; DDS (aromatic sulfone) at higher \(\delta _p\).}}{10}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Density on RadonPy PI1070} (Push \#36/\#38). \textcolor {Green}{\bfseries  GOOD}\ RF beats VK physics by 57\% MAE; the stacked RF+VK ensemble adds R\textsuperscript  {2} +0.08 and improved rank correlation. The Wolpert 1992 stack keeps interpretable weights (\(w_{\text  {RF}} = 0.635, w_{\text  {VK}} = 0.288\)) --- data and physics both contribute.}}{14}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Cross-dataset generalisation (Push \#33/\#34).} Push \#33 is our best-signed \emph  {honest-negative}: an OpenPoly-trained dielectric ML model deteriorates from MAE 0.40 to MAE 4.04 on RadonPy MD-simulated polymers because the training and test distributions differ by 3.5\(\times \) in median. Push \#34 closes the gap by mixed-source training.}}{14}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Amphora vs best-practice targets.} On \(\rho \) and \(n_D\) we hit or beat published Van~Krevelen accuracies. On \(T_g\) we trail Bicerano's tightest 30\,K target by \(\sim 20\)\,K --- but Bicerano numbers are within-data and ours are cross-scaffold held-out, so the comparison is deliberately unfavourable to us.}}{15}{figure.caption.8}\protected@file@percent }
