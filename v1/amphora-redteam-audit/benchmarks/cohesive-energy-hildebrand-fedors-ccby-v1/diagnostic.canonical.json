  "schema": "amphora.redteam-audit.cohesive-energy-hildebrand-fedors-ccby-v1",
  "target_capability": "cohesive-energy-density-hildebrand-solubility-parameter-group-contribution",
  "target_module": "amphora-solvency-score",
  "theory": "Hildebrand: CED=(dHvap-RT)/Vm, delta=sqrt(CED). Fedors 1974 group-contribution cohesive energy E_coh=sum n_i*de_i (Van Krevelen ch.7); de_i are universal literature constants NOT fitted to this set -> non-circular. Predictor and calorimetric reference share the MEASURED Vm=M/rho, so the test isolates the group cohesive-energy sum vs the calorimetric cohesive energy (dHvap-RT) with no dependence on group volume increments. Hoftyzer-Van Krevelen partial parameters (delta_d/delta_p/delta_h) give an independent second group method. delta and its Hansen decomposition drive solvent selection, resin/hardener/pigment compatibility and solvent-blend design in two-part epoxy-amine coatings, and are the direct input to the amphora-solvency-score Hansen-distance module.",
  "verdict": {
    "applicability_domain": "Fedors group-contribution cohesive energy predicts the Hildebrand solubility parameter of non-associating AND H-bonding coating solvents (aromatics, aliphatics, cyclics, ketones, esters, alcohols) to within a few percent of the calorimetric ground truth, corroborated by an independent second group method. Two honest applicability-boundary cases are reported not hidden: styrene (extended vinyl-aryl conjugation) and chlorobenzene (aromatic-halogen cohesive increment carried at the aliphatic-Cl value). Water is excluded from the group predictor (no organic-group decomposition) but retained for the calorimetric reference.",
    "core_model_beats_null": true,
    "graded_outcome": "VALIDATED_IN_DOMAIN",
    "is_a_phase0_gate": false
  }
