{
  "schema": "amphora.benchmark-lock.v1",
  "benchmark_id": "molecule-property-phase-1-lock-v2-2026-07-18",
  "module_id": "amphora-molecule-property",
  "endpoints": [
    "structure_identity",
    "average_molecular_weight_g_mol",
    "oxirane_ring_count",
    "reactive_amine_hydrogen_count",
    "eew_g_per_eq",
    "ahew_g_per_eq"
  ],
  "baselines": [
    "independently_generated_structure_and_mass_reference",
    "sealed_reactive_group_controls",
    "invalid_and_out_of_domain_controls"
  ],
  "metrics": [
    {"metric":"reactive_group_count_accuracy","direction":"maximize","unit":"fraction_0_1","threshold":1.0},
    {"metric":"invalid_rejection_accuracy","direction":"maximize","unit":"fraction_0_1","threshold":1.0},
    {"metric":"eew_ahew_max_abs_error","direction":"minimize","unit":"g/eq","threshold":0.5},
    {"metric":"structure_identity_and_mass_agreement","direction":"maximize","unit":"fraction_0_1","threshold":1.0},
    {"metric":"measured_only_claim_lock_preservation","direction":"maximize","unit":"fraction_0_1","threshold":1.0}
  ],
  "uncertainty_method": "deterministic exact-control agreement; no sampling uncertainty asserted",
  "thresholds": {
    "minimum_truth_set_molecules": 300.0,
    "minimum_reactive_group_count_accuracy": 1.0,
    "minimum_invalid_rejection_accuracy": 1.0,
    "maximum_eew_ahew_abs_error_g_per_eq": 0.5,
    "minimum_measured_only_claim_lock_preservation": 1.0
  },
  "exclusions": [
    "mixtures, fragments, wildcards, query atoms, and polymers",
    "commercial products and polydisperse grades as structure-derived EEW/AHEW",
    "InChI, MOL, and SDF candidate-input ingestion during Phase 1"
  ],
