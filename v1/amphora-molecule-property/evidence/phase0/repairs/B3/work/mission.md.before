| CH3 | 5200 | +6151.5 | +1.18 | 807 |
| CH | 4600 | +6779.8 | +1.47 | 807 |
| ether_O | 4000 | +2375.5 | +0.59 | 807 |
| primary_amine | 8000 | +7228.5 | +0.90 | 807 |
| epoxide | 6000 | +4167.8 | +0.69 | 807 |
| C_quat | 4900 | +4474.2 | +0.91 | 740 |
| vinyl_CH | 1900 | +5094.0 | +2.68 | 656 |
