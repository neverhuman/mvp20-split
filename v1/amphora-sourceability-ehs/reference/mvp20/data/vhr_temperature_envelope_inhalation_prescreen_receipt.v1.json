{"authority":"AUDIT_ONLY","human_review_performed":false,"kpis":{"aggregate":{"band_migrators_in_envelope":["ethylbenzene","m_xylene","n_butanol"],"boiling_violations":[],"finding":"Saturated-headspace inhalation hazard is strongly temperature-dependent: over the 15-40 C marine confined-space envelope every admitted solvent's VHR amplifies several-fold, and slow alcohols that read MODERATE at 25 C can cross into the HIGH engineering-ventilation band at application temperature. A single 25 C VHR under-states confined-space inhalation hazard.","max_amplification_15to40":6.36,"max_amplification_solvent":"n_butanol","min_amplification_15to40":3.246,"min_amplification_solvent":"mek_2_butanone","n_band_migrators":3,"rank_order_25C":["methanol","mek_2_butanone","toluene","ethylbenzene","m_xylene","n_butanol"],"rank_order_40C":["methanol","mek_2_butanone","toluene","ethylbenzene","m_xylene","n_butanol"],"spearman_rho_25C_vs_40C_ranking":1.0,"worst_actor_by_temperature":{"15.0":"methanol","20.0":"methanol","25.0":"methanol","30.0":"methanol","35.0":"methanol","40.0":"methanol"},"worst_actor_temperature_invariant":true},"authority_ceiling_note":"EVIDENCE_ONLY quantitative temperature-resolved inhalation-hazard PRESCREEN. Profiles intrinsic vapour-inhalation hazard across the marine confined-space application-temperature envelope to prioritise engineering ventilation. Does NOT establish OSHA compliance, control banding, respirator selection, procurement approval, or regulatory closure. Complements the module's 25 C VHR and qualitative GHS/CLP prescreens.","concordance_records":[{"concordant":true,"reason_code":null,"relative_error":0.00035,"solvent":"methanol","tolerance":0.15,"vp_antoine_mmHg_25C":127.0445,"vp_pubchem_mmHg_25C":127.0},{"concordant":true,"reason_code":null,"relative_error":0.00461,"solvent":"mek_2_butanone","tolerance":0.15,"vp_antoine_mmHg_25C":90.1826,"vp_pubchem_mmHg_25C":90.6},{"concordant":true,"reason_code":null,"relative_error":0.00154,"solvent":"toluen