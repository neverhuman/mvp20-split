  "convention_definitions": {
    "conventionA_amine_centres": {
      "definition": "The number of DISTINCT epoxy-relevant nitrogen ATOMS in the molecule, counted once per nitrogen regardless of how many hydrogens it bears. A nitrogen qualifies iff it is trivalent (NX3), formally neutral, not an aromatic-ring member, carries no multiple bond, and is not attached to a carbonyl/thiocarbonyl carbon (amide/thioamide N is not epoxy-reactive at ambient cure). Primary -NH2, secondary -NH- and TERTIARY -N< all count as 1.",
      "does_not_govern": "AHEW, epoxy:amine mix ratio, or network functionality.",
      "governs": "ASTM D2074 total amine value, AV = 56105.6 * n_basicN / M (mg KOH/g).",
      "name": "amine centres (n_amine_centres; the generator's `amine_sites` column; ASTM D2074 n_basicN)",
      "rdkit_smarts_reference_implementation": "[NX3;!$(NC=O);!$(N=*);!$(N#*);!a]"
    },
    "conventionB_active_hydrogen_functionality": {
      "definition": "The number of N-H HYDROGENS carried by those same qualifying nitrogen centres, i.e. the number of hydrogens available for epoxide ring-opening addition. Primary -NH2 contributes 2, secondary -NH- contributes 1, tertiary -N< contributes 0. Aromatic-ring N, amide N and multiply-bonded N contribute 0 because they are excluded as centres.",
      "governs": "AHEW = M / n_activeH (Lee & Neville 1967); mix ratio phr = 100 * AHEW / EEW at 1:1 epoxide:amine-hydrogen stoichiometry; Flory-Stockmayer network functionality f and hence gel point and crosslink density.",
      "independence": "n_active_nh is NOT a function of n_amine_centres: a primary,primary diamine has 2 centres and f=4; a secondary,secondary diamine has 2 centres and f=2; a tertiary,tertiary diamine has 2 centres and f=0.",
      "name": "active-hydrogen functionality (n_active_nh; active_NH; Flory-Stockmayer f)"
    },
    "the_word_difunctional": {
      "consequence_if_confused": "For a primary,primary diamine the amine-centre count is exactly half the active-hydrogen count, so treating centres as functionality doubles AHEW and therefore doubles the hardener mix ratio phr -- a 2x stoichiometric overdose that leaves roughly half the epoxide groups unreacted.",
      "difunctional_means": "active_NH == 2 (f = 2)",
      "portfolio_convention_to_use": "conventionB_active_hydrogen_functionality",
      "recommended_wording": "Call the 2-centre subset 'diamines' or 'two amine centres', never 'difunctional'. Publish n_amine_centres and active_NH as two separately named columns and never collapse them into one word.",
      "why": "'Functionality' denotes the number of independent bond-forming reactions the molecule can undergo with the co-reactant, not the number of heteroatoms it contains. For an epoxy-amine system that count is the active-hydrogen count: it is what AHEW is defined as (M / n_activeH), what the mix ratio phr is computed from (100 * AHEW / EEW), and what Flory-Stockmayer gelation theory takes as f. The nitrogen-atom count enters only the amine VALUE (ASTM D2074), a titration quantity, and sets no stoichiometry. This module's own in-tree reference file already encodes the active-hydrogen convention as ground truth (hardener_stoichiometric_envelope.v1.json: 'AHEW = M / n_activeH ... Lee & Neville 1967', with expected_active_nh = 4 for MDA/DDM, IPDA, m-XDA, DDS and 1,3-BAC), so using the nitrogen-atom count for the word 'difunctional' put the generator's label in direct contradiction with the module's own reference data."
    }
  },
