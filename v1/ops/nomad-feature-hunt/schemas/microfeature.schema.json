{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amphora.local/schemas/nomad-microfeature.schema.json",
  "title": "NOMAD executable scalar microfeature",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "feature_id", "concept_id", "domain", "base_equation_id", "equation", "symbols",
    "inputs", "parameters", "units", "normalization", "periodic_construction", "invariances",
    "missingness_policy", "physical_interpretation", "citations_or_derivation",
    "target_hypothesis", "complexity", "generator_hash", "leakage_assessment",
    "falsification_test", "measured_results"
  ],
  "properties": {
    "feature_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "concept_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "domain": {"enum": ["D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10"]},
    "base_equation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "equation": {"type": "string", "minLength": 1},
    "symbols": {"type": ["object", "array"], "minProperties": 1},
    "inputs": {"type": "array", "minItems": 1},
    "parameters": {"type": ["object", "array"], "minProperties": 1},
    "units": {"type": ["string", "object"], "minLength": 1},
    "normalization": {"type": "string", "minLength": 1},
    "periodic_construction": {"type": "string", "minLength": 1},
    "invariances": {"type": ["object", "array"], "minProperties": 1},
    "missingness_policy": {"type": "string", "minLength": 1},
    "physical_interpretation": {"type": "string", "minLength": 1},
    "citations_or_derivation": {"type": ["object", "array", "string"]},
    "target_hypothesis": {"type": "string", "minLength": 1},
    "complexity": {"type": ["object", "string"], "minLength": 1},
    "generator_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "leakage_assessment": {"type": "string", "minLength": 1},
    "falsification_test": {"type": "string", "minLength": 1},
    "measured_results": {"type": "object", "minProperties": 1}
  }
}
