{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nomad-feature-hunt/v2.1/genetic-reduction-history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "target", "population_size", "generations", "seed", "history", "preregistered_views"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "receipt_type": {"const": "genetic_reduction_history"},
    "target": {"enum": ["formation_energy_ev_natom", "bandgap_energy_ev"]},
    "population_size": {"const": 24},
    "generations": {"const": 10},
    "seed": {"type": "integer"},
    "history": {"type": "array", "minItems": 10, "maxItems": 10},
    "preregistered_views": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["view_id"]}}
  }
}
