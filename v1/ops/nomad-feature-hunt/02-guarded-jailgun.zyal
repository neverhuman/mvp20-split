<<<ZYAL v1:daemon id=nomad-feature-hunt-jailgun>>>
version: v1
intent: daemon
confirm: RUN_FOREVER
id: nomad-feature-hunt-jailgun

job:
  name: "Guarded ten-tab GPT-5.6 NOMAD batch"
  objective: "Obtain exactly 50 schema-valid concepts in each of ten domain-mapped fresh conversations."

loop:
  policy: bounded
  max_iterations: 1
  sleep: 2s
  circuit_breaker:
    max_consecutive_errors: 1
    on_trip: halt
engine:
  command: "python3 -m nomad_feature_hunt.controller jailgun --run-id ${RUN_ID:?RUN_ID_required}"

identity:
  exact_visible_model: GPT-5.6
  account_capacity: 10
  pre_and_post_receipts: required
  failed_probe: hard_block

archive:
  required_paths: ["features/tab_XX.md", "features/tab_XX.json"]
  concepts_per_tab: 50
  path_traversal_and_links: reject
  jnoccio_substitution: forbidden
  invalid_tab_retry: one_fresh_conversation
<<<END_ZYAL id=nomad-feature-hunt-jailgun>>>
ZYAL_ARM RUN_FOREVER id=nomad-feature-hunt-jailgun
