{
  "$id": "https://amphora.local/schemas/module-evidence-inventory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amphora module evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "audit_date",
    "module_count",
    "hash_algorithm",
    "modules"
  ],
  "properties": {
    "$schema": {"const": "../schemas/module-evidence-inventory.schema.json"},
    "schema": {"const": "amphora.module-evidence-inventory.v1"},
    "audit_date": {"type": "string", "format": "date"},
    "module_count": {"const": 29},
    "hash_algorithm": {"const": "SHA-256"},
    "modules": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "moduleId": {"type": "string", "pattern": "^amphora-[a-z0-9-]+$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adapterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "candidate_type",
        "model_id",
        "dataset_id",
        "solver_use",
        "model_readiness_status"
      ],
      "properties": {
        "track_id": {"type": "string", "minLength": 1},
        "candidate_type": {"enum": ["molecule", "formulation", "evidence_package"]},
        "model_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "solver_use": {"enum": ["DISABLED", "AUDIT_ONLY", "CONSTRAINT_ONLY", "OBJECTIVE", "R&D_OBJECTIVE"]},
        "model_readiness_status": {"enum": ["NOT_PROVEN", "MODEL_READINESS_ONLY", "R&D_RANKING_READY", "COMPUTATIONAL_VALIDATED", "NOT_APPLICABLE"]}
      }
    },
    "runtimeIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_registered", "registry_path", "registry_sha256", "adapter_policy"],
      "properties": {
        "adapter_registered": {"type": "boolean"},
        "registry_path": {"enum": ["science/adapters.py", "amphora-engine/src/lib.rs", "amphora-formulation-capabilities/src/lib.rs"]},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_policy": {
          "oneOf": [
            {"$ref": "#/$defs/adapterPolicy"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"adapter_registered": {"const": true}}},
          "then": {"properties": {"adapter_policy": {"$ref": "#/$defs/adapterPolicy"}}},
          "else": {"properties": {"adapter_policy": {"type": "null"}}}
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_path", "gap"],
      "properties": {
        "status": {"enum": ["KNOWN", "UNRESOLVED"]},
        "evidence_path": {
          "oneOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        },
        "gap": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "KNOWN"}}},
          "then": {"properties": {"evidence_path": {"$ref": "#/$defs/path"}}},
          "else": {"properties": {"evidence_path": {"type": "null"}}}
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind", "rights"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["dataset", "output_artifact", "input_fixture"]},
        "rights": {"$ref": "#/$defs/rights"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_path", "value"],
      "properties": {
        "json_path": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_path",
        "artifact_sha256",
        "reported_result_status",
        "observations",
        "gap"
      ],
      "properties": {
        "status": {
          "enum": [
            "NO_CHECKED_BENCHMARK_RESULT",
            "CHECKED_ARTIFACT_REPORTED_STATUS",
            "CHECKED_ARTIFACT_REPORTED_METRICS"
          ]
        },
        "artifact_path": {
          "oneOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        },
        "artifact_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "reported_result_status": {"type": ["string", "null"]},
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observation"}
        },
        "gap": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "NO_CHECKED_BENCHMARK_RESULT"}}},
          "then": {
            "properties": {
              "artifact_path": {"type": "null"},
              "artifact_sha256": {"type": "null"},
              "reported_result_status": {"type": "null"},
              "observations": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "artifact_path": {"$ref": "#/$defs/path"},
              "artifact_sha256": {"$ref": "#/$defs/sha256"},
              "observations": {"minItems": 1}
            }
          }
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version", "version_source_path", "version_source_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "version_source_path": {"$ref": "#/$defs/path"},
        "version_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "portfolioEdges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "consumers"],
      "properties": {
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/moduleId"}},
        "consumers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/moduleId"}}
      }
    },
    "redTeamFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "selector", "scenario"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "selector": {"type": "string", "pattern": "^test_[a-z0-9_]+$"},
        "scenario": {"type": "string", "minLength": 1}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "implementation",
        "tests",
        "runtime_integration",
        "portfolio_edges",
        "artifacts",
        "artifact_gap",
        "current_benchmark",
        "known_contradictions",
        "external_dependencies",
        "focused_acceptance_command",
        "red_team_fixture"
      ],
      "properties": {
        "module_id": {"$ref": "#/$defs/moduleId"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fileEvidence"}},
        "runtime_integration": {"$ref": "#/$defs/runtimeIntegration"},
        "portfolio_edges": {"$ref": "#/$defs/portfolioEdges"},
        "artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
        "artifact_gap": {"type": "string", "minLength": 1},
        "current_benchmark": {"$ref": "#/$defs/benchmark"},
        "known_contradictions": {"$ref": "#/$defs/nonEmptyStrings"},
        "external_dependencies": {"$ref": "#/$defs/nonEmptyStrings"},
        "focused_acceptance_command": {"type": "string", "pattern": "^rtk cargo test --workspace --locked$"},
        "red_team_fixture": {"$ref": "#/$defs/redTeamFixture"}
      }
    }
  }
}
