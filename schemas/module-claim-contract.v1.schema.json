{
  "$id": "https://amphora.local/schemas/module-claim-contract.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": ["schema", "module_id", "registry_manifest_hash", "module_class", "scientific_readiness_ceiling", "decision_use_ceiling", "applicability_domain", "abstain_outside_applicability", "claim_locks", "prohibited_authorities"],
  "properties": {
    "schema": {"const": "amphora.module-claim-contract.v1"},
    "module_id": {"$ref": "#/$defs/module"},
    "registry_manifest_hash": {"$ref": "#/$defs/hash"},
    "module_class": {"enum": ["DETERMINISTIC_CONTROL", "SCIENTIFIC_OR_EVIDENCE"]},
    "scientific_readiness_ceiling": {"enum": ["LOCKED_INTERNAL", "NOT_APPLICABLE"]},
    "decision_use_ceiling": {"const": "AUDIT_ONLY"},
    "applicability_domain": {"$ref": "#/$defs/nonempty"},
    "abstain_outside_applicability": {"const": true},
    "claim_locks": {"type": "object", "minProperties": 10, "additionalProperties": {"const": true}},
    "prohibited_authorities": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "module": {"type": "string", "pattern": "^amphora-[a-z0-9-]+$"},
    "nonempty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "type": "object"
}
