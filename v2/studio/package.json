{
  "name": "@amphora/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/verify.mjs",
    "test:interaction": "node spikes/interaction/tests/browser.mjs",
    "preview:interaction": "node spikes/interaction/preview.mjs",
    "test:browser": "npm run build && node tests/browser/monitor.mjs",
    "test:navigation": "npm run build && node tests/browser/navigation.mjs",
    "test:evidence": "npm run build && node tests/browser/evidence.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "7.29.9",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cytoscape": "3.34.3",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
