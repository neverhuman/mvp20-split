{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "generation": {
          "maximum": 8,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "parent_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Parent Ids",
          "type": "array"
        },
        "proposal_index": {
          "maximum": 7,
          "minimum": 0,
          "title": "Proposal Index",
          "type": "integer"
        },
        "proposal_seed": {
          "maximum": 1100000,
          "minimum": 0,
          "title": "Proposal Seed",
          "type": "integer"
        },
        "scoring_seed": {
          "maximum": 1100000,
          "minimum": 0,
          "title": "Scoring Seed",
          "type": "integer"
        },
        "structure": {
          "const": "unchanged-reference-structure",
          "default": "unchanged-reference-structure",
          "title": "Structure",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "parent_ids",
        "generation",
        "proposal_index",
        "proposal_seed",
        "scoring_seed"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ModuleEnvelope": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "NO_AUTHORITY",
          "default": "NO_AUTHORITY",
          "title": "Authority",
          "type": "string"
        },
        "module_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Module Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "SYNTHETIC",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "status"
      ],
      "title": "ModuleEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "display_score": {
      "const": 0,
      "default": 0,
      "title": "Display Score",
      "type": "integer"
    },
    "eligible_objectives": {
      "const": 0,
      "default": 0,
      "title": "Eligible Objectives",
      "type": "integer"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ModuleEnvelope"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Modules",
      "type": "array"
    },
    "ranked": {
      "const": false,
      "default": false,
      "title": "Ranked",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "modules"
  ],
  "title": "ScoreResult",
  "type": "object"
}
