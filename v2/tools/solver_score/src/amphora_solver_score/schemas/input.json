{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "generation": {
          "maximum": 8,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "parent_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Parent Ids",
          "type": "array"
        },
        "proposal_index": {
          "maximum": 7,
          "minimum": 0,
          "title": "Proposal Index",
          "type": "integer"
        },
        "proposal_seed": {
          "maximum": 1100000,
          "minimum": 0,
          "title": "Proposal Seed",
          "type": "integer"
        },
        "scoring_seed": {
          "maximum": 1100000,
          "minimum": 0,
          "title": "Scoring Seed",
          "type": "integer"
        },
        "structure": {
          "const": "unchanged-reference-structure",
          "default": "unchanged-reference-structure",
          "title": "Structure",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "parent_ids",
        "generation",
        "proposal_index",
        "proposal_seed",
        "scoring_seed"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "SourcePins": {
      "additionalProperties": false,
      "properties": {
        "cli": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cli",
          "type": "string"
        },
        "engine": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine",
          "type": "string"
        },
        "ranking": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ranking",
          "type": "string"
        }
      },
      "required": [
        "cli",
        "engine",
        "ranking"
      ],
      "title": "SourcePins",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "error_modules": {
      "default": [],
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Error Modules",
      "type": "array"
    },
    "fail_scoring": {
      "default": false,
      "title": "Fail Scoring",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_pins": {
      "$ref": "#/$defs/SourcePins"
    }
  },
  "required": [
    "source_pins",
    "candidate"
  ],
  "title": "ScoreRequest",
  "type": "object"
}
