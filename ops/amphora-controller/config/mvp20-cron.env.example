# Installed as /home/ubuntu/.config/amphora/mvp20-cron.env (mode 0600).
# Literal KEY=VALUE only; exported environment variables override these values.
AMPHORA_REPO_ROOT=/home/ubuntu/mvp20-split
AMPHORA_CONTROLLER_ROOT=/home/ubuntu/mvp20-split/ops/amphora-controller
AMPHORA_STATE_ROOT=/home/ubuntu/amphora-cron
AMPHORA_CAMPAIGN_PATH=/home/ubuntu/amphora-cron/campaign.json
AMPHORA_QUEUE_PATH=/home/ubuntu/amphora-cron/data-acquisition-queue.jsonl
AMPHORA_PROMPT_PATH=/home/ubuntu/mvp20-split/ops/amphora-controller/claude-hourly-loop.prompt.txt
AMPHORA_DIRECTIVE_REGISTRY=/home/ubuntu/mvp20-split/ops/amphora-controller/directives/REGISTRY.json
AMPHORA_TARGET_HOST=xbabe2
AMPHORA_TARGET_ROOT=/home/ubuntu/amphora/build/mvp20-split
AMPHORA_MODEL=claude-sonnet-5
AMPHORA_CLAUDE_BIN=/home/ubuntu/.local/bin/claude
AMPHORA_SIGNING_KEY_PATH=/home/ubuntu/.local/share/amphora/phase0/keys/evaluator.ed25519.seed
AMPHORA_SSH_COMMAND=ssh -o ConnectTimeout=15 -o BatchMode=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=6
