#!/usr/bin/env python3
"""Operator CLI for the intentionally paused Amphora automation fleet."""

import argparse
import fcntl
import hashlib
import json
import os
import socket
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time


DEFAULTS = {
    "AMPHORA_REPO_ROOT": "/home/ubuntu/mvp20-split",
    "AMPHORA_CONTROLLER_ROOT": "/home/ubuntu/mvp20-split/ops/amphora-controller",
    "AMPHORA_STATE_ROOT": "/home/ubuntu/amphora-cron",
    "AMPHORA_CAMPAIGN_PATH": "/home/ubuntu/amphora-cron/campaign.json",
    "AMPHORA_QUEUE_PATH": "/home/ubuntu/amphora-cron/data-acquisition-queue.jsonl",
    "AMPHORA_PROMPT_PATH": "/home/ubuntu/mvp20-split/ops/amphora-controller/claude-hourly-loop.prompt.txt",
    "AMPHORA_DIRECTIVE_REGISTRY": "/home/ubuntu/mvp20-split/ops/amphora-controller/directives/REGISTRY.json",
    "AMPHORA_CONTROLLER_HOST": "xbabe1",
    "AMPHORA_TARGET_HOST": "xbabe2",
    "AMPHORA_TARGET_ROOT": "/home/ubuntu/amphora/build/mvp20-split",
    "AMPHORA_MODEL": "claude-sonnet-5",
    "AMPHORA_CLAUDE_BIN": "/home/ubuntu/.local/bin/claude",
    "AMPHORA_SIGNING_KEY_PATH": "/home/ubuntu/.local/share/amphora/phase0/keys/evaluator.ed25519.seed",
    "AMPHORA_SSH_COMMAND": "ssh -o ConnectTimeout=15 -o BatchMode=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=6",
    "AMPHORA_SCP_COMMAND": "scp -o ConnectTimeout=15 -o BatchMode=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=6",
}
TAG_RX = re.compile(r"^[A-Z0-9][A-Z0-9._-]{7,127}$")


class OperatorError(RuntimeError):
    pass


def run(argv, *, input_text=None, check=True, capture=True):
    proc = subprocess.run(argv, input=input_text, text=True,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.PIPE if capture else None)
    if check and proc.returncode:
        raise OperatorError("command failed (%d): %s\n%s" %
                            (proc.returncode, " ".join(map(str, argv)),
                             (proc.stderr or "").strip()))
    return proc


def parse_env(path):
    values = {}
    try:
        lines = path.read_text().splitlines()
    except FileNotFoundError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if key in DEFAULTS:
            values[key] = value.strip("'\"")
    return values


def config():
    cfg_path = Path(os.environ.get(
        "AMPHORA_CONFIG_FILE", "/home/ubuntu/.config/amphora/mvp20-cron.env"))
    values = dict(DEFAULTS)
    values.update(parse_env(cfg_path))
    values.update({key: os.environ[key] for key in DEFAULTS if key in os.environ})
    values["AMPHORA_CONFIG_FILE"] = str(cfg_path)
    return values


def command_argv(cfg, key):
    argv = shlex.split(cfg[key])
    if not argv:
        raise OperatorError("%s is empty" % key)
    return argv


def ssh_argv(cfg, host, *remote_command):
    return [*command_argv(cfg, "AMPHORA_SSH_COMMAND"), host, *remote_command]


def scp_argv(cfg, *paths):
    return [*command_argv(cfg, "AMPHORA_SCP_COMMAND"), *paths]


def tag_arg(value):
    if not TAG_RX.fullmatch(value or ""):
        raise argparse.ArgumentTypeError("tag must be 8-128 uppercase letters, digits, '.', '_' or '-'")
    return value


def cron_entries(cfg):
    controller = cfg["AMPHORA_CONTROLLER_ROOT"]
    return {
        "launcher": "0 * * * * %s/claude-hourly-loop.sh" % controller,
        "mirror": "*/10 * * * * %s/mirror-log.sh >/dev/null 2>&1" % controller,
        "guard": "30 * * * * flock -n /tmp/amphora-git-autocommit.lock /home/ubuntu/.local/libexec/amphora-autocommit-guard.sh >/dev/null 2>&1",
    }


def is_target_cron(line, role):
    needles = {
        "launcher": ("amphora-cron/claude-hourly-loop.sh", "amphora-controller/claude-hourly-loop.sh"),
        "mirror": ("amphora-cron/mirror-log.sh", "amphora-controller/mirror-log.sh"),
        "guard": ("amphora-autocommit-guard.sh",),
    }
    contains_job = any(needle in line for needle in needles[role])
    is_managed_disabled = any(
        marker in line for marker in ("AMPHORA_HANDOFF_DISABLED", "AMPHORA_MANAGED_DISABLED"))
    return contains_job and (not line.lstrip().startswith("# ") or is_managed_disabled)


def update_cron(text, roles, entries, enabled, tag):
    lines = text.splitlines()
    kept = [line for line in lines if not any(is_target_cron(line, role) for role in roles)]
    for role in roles:
        entry = entries[role]
        kept.append(entry if enabled else "# AMPHORA_MANAGED_DISABLED %s %s" % (tag, entry))
    return "\n".join(kept) + "\n"


def read_cron(cfg, host=None):
    argv = ["crontab", "-l"] if host is None else ssh_argv(cfg, host, "crontab", "-l")
    proc = run(argv, check=False)
    if proc.returncode not in (0, 1):
        raise OperatorError(proc.stderr.strip())
    return proc.stdout


def write_cron(cfg, text, host=None):
    argv = ["crontab", "-"] if host is None else ssh_argv(cfg, host, "crontab", "-")
    run(argv, input_text=text)


def set_crons(cfg, enabled, tag, apply):
    entries = cron_entries(cfg)
    local_before = read_cron(cfg)
    target = cfg["AMPHORA_TARGET_HOST"].strip()
    if not target:
        # Standalone host: there is no remote guard entry to toggle.
        local_after = update_cron(local_before, ("launcher", "mirror"), entries, enabled, tag)
        if not apply:
            print("would set the two local Amphora cron jobs %s (standalone: no remote guard)"
                  % ("enabled" if enabled else "disabled"))
            return
        write_cron(cfg, local_after)
        return
    remote_before = read_cron(cfg, target)
    local_after = update_cron(local_before, ("launcher", "mirror"), entries, enabled, tag)
    remote_after = update_cron(remote_before, ("guard",), entries, enabled, tag)
    if not apply:
        print("would set Amphora cron jobs %s; unrelated lines remain byte-identical" %
              ("enabled" if enabled else "disabled"))
        return
    write_cron(cfg, local_after)
    try:
        write_cron(cfg, remote_after, cfg["AMPHORA_TARGET_HOST"])
    except Exception:
        write_cron(cfg, local_before)
        raise


def stop_path(cfg):
    return Path(cfg["AMPHORA_STATE_ROOT"]) / "state" / "HARD_STOP"


def require_matching_stop(cfg, tag):
    path = stop_path(cfg)
    try:
        content = path.read_text().splitlines()[0]
    except (FileNotFoundError, IndexError):
        raise OperatorError("owned hard stop is absent: %s" % path)
    if content != tag:
        raise OperatorError("refusing foreign hard stop %r (expected %r)" % (content, tag))
    return path


def require_controller_host(cfg):
    """Refuse an APPLIED host mutation anywhere but the controller host.

    Dry runs are unaffected and can be previewed from any host.

    install/pause/resume reach the target host over `ssh $AMPHORA_TARGET_HOST` to
    write its crontab and deploy the guard. That alias is only guaranteed to mean
    the real target when resolved from the controller host: an ~/.ssh/config entry
    on another machine can silently point the same name somewhere else, in which
    case these commands would rewrite an unrelated host's crontab. Fail closed.
    """
    expected = cfg["AMPHORA_CONTROLLER_HOST"]
    actual = socket.gethostname().split(".")[0]
    if actual != expected:
        raise OperatorError(
            "refusing to run on %r: this command mutates %s and %s over ssh and must run "
            "on the controller host %r (from %s). Override only if you are certain the "
            "ssh aliases resolve correctly here: AMPHORA_CONTROLLER_HOST=%s"
            % (actual, expected, cfg["AMPHORA_TARGET_HOST"], expected,
               cfg["AMPHORA_REPO_ROOT"], actual))


def cmd_pause(args, cfg):
    path = stop_path(cfg)
    if not args.apply:
        print("DRY-RUN: would create %s with tag %s, then disable exactly three jobs" % (path, args.tag))
        return 0
    require_controller_host(cfg)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        with path.open("x") as fh:
            fh.write(args.tag + "\n")
        path.chmod(0o600)
    except FileExistsError:
        require_matching_stop(cfg, args.tag)
    set_crons(cfg, False, args.tag, True)
    print("paused tag=%s" % args.tag)
    return 0


def remote_process_count(cfg, host):
    script = """ps -u "$(id -un)" -o args= | grep -E '[c]laude-hourly-loop|(^|/)claude( |$)' | wc -l"""
    argv = ["bash", "-c", script] if host is None else ssh_argv(cfg, host, script)
    proc = run(argv, check=False)
    return int((proc.stdout or "0").strip() or 0) if proc.returncode == 0 else 999


def controller_locks_available(cfg):
    """Hold every controller lock together long enough to prove a full drain."""
    lock_root = Path(cfg["AMPHORA_STATE_ROOT"]) / "state" / "locks"
    lock_root.mkdir(parents=True, exist_ok=True)
    handles = []
    try:
        for name in ("lane-1.lock", "lane-2.lock", "lane-3.lock", "lane-4.lock",
                     "fleet.lock", "campaign.lock", "state.lock"):
            handle = (lock_root / name).open("a")
            handles.append(handle)
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False
    finally:
        for handle in handles:
            handle.close()


def cmd_drain(args, cfg):
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if remote_process_count(cfg, None) == 0 and controller_locks_available(cfg):
            print("drained: no controller or Claude processes; all fleet locks available")
            return 0
        time.sleep(1)
    raise OperatorError("fleet did not drain within %ss" % args.timeout)


def cmd_resume(args, cfg):
    path = require_matching_stop(cfg, args.tag)
    if not args.apply:
        print("DRY-RUN: would enable exactly three jobs and remove only %s" % path)
        return 0
    require_controller_host(cfg)
    set_crons(cfg, True, args.tag, True)
    require_matching_stop(cfg, args.tag).unlink()
    print("resumed tag=%s; all three reviewed jobs enabled" % args.tag)
    return 0


def verify_manifest(controller):
    manifest = controller / "controller-tree.sha256"
    if not manifest.is_file():
        return False, "controller-tree.sha256 missing"
    symlinks = [path.relative_to(controller).as_posix() for path in controller.rglob("*")
                if path.is_symlink()]
    if symlinks:
        return False, "controller contains symlink: %s" % symlinks[0]
    actual = []
    for path in sorted(controller.rglob("*")):
        if path.is_file() and path != manifest:
            actual.append((hashlib.sha256(path.read_bytes()).hexdigest(),
                           path.relative_to(controller).as_posix()))
    try:
        expected = [tuple(line.split("  ", 1))
                    for line in manifest.read_text().splitlines() if line]
    except ValueError:
        return False, "controller manifest is malformed"
    if expected != actual:
        expected_paths = {row[1] for row in expected if len(row) == 2}
        actual_paths = {row[1] for row in actual}
        extras = sorted(actual_paths - expected_paths)
        missing = sorted(expected_paths - actual_paths)
        if extras:
            return False, "unlisted controller file: %s" % extras[0]
        if missing:
            return False, "controller manifest path missing: %s" % missing[0]
        return False, "controller hash mismatch"
    return True, "controller hashes verified"


def cmd_doctor(args, cfg):
    failures = []
    for program in ("bash", "flock", "git", "jq", "python3", "rsync", "sha256sum", "ssh"):
        if shutil.which(program) is None:
            failures.append("missing program: %s" % program)
    controller = Path(cfg["AMPHORA_CONTROLLER_ROOT"])
    ok, detail = verify_manifest(controller)
    if not ok:
        failures.append(detail)
    if controller.exists():
        writable = [str(p.relative_to(controller)) for p in controller.rglob("*")
                    if p.lstat().st_mode & 0o222]
        if writable:
            failures.append("controller paths retain write bits: %s" % ", ".join(writable[:5]))
    cfg_path = Path(cfg["AMPHORA_CONFIG_FILE"])
    if cfg_path.exists() and cfg_path.stat().st_mode & 0o077:
        failures.append("config must be mode 0600: %s" % cfg_path)
    # A consolidated handoff host has no target: it holds the data and the signing seed
    # locally and cannot reach the canonical tree by design. Setting AMPHORA_TARGET_HOST
    # empty declares that, so the remote checks below are skipped as inapplicable rather
    # than reported as a bare "SSH failed" on a host that is in fact healthy.
    target = cfg["AMPHORA_TARGET_HOST"].strip()
    if not target:
        print("standalone: no target host configured; remote checks skipped")
        seed = Path(cfg["AMPHORA_SIGNING_KEY_PATH"])
        if not seed.is_file():
            failures.append("local signing seed absent: %s" % seed)
        elif seed.stat().st_size != 32:
            failures.append("local signing seed is %d bytes, expected 32" % seed.stat().st_size)
        elif seed.stat().st_mode & 0o077:
            failures.append("local signing seed must be mode 0600: %s" % seed)
        else:
            print("standalone: local signing seed present (32 bytes, 0600)")
    elif run(ssh_argv(cfg, target, "true"), check=False).returncode:
        failures.append(
            "SSH failed: %s (set AMPHORA_TARGET_HOST empty if this host is standalone)" % target)
    else:
        seed_path = shlex.quote(cfg["AMPHORA_SIGNING_KEY_PATH"])
        key_check = "test -f %s && test $(wc -c < %s) -eq 32" % (seed_path, seed_path)
        if run(ssh_argv(cfg, target, key_check), check=False).returncode:
            failures.append("remote signing seed absent or wrong size")
        for local_name, remote_name in (
                ("autocommit-guard.sh", "/home/ubuntu/.local/libexec/amphora-autocommit-guard.sh"),
                ("policy/staged_file_policy.py", "/home/ubuntu/.local/libexec/amphora-staged-file-policy.py")):
            expected = hashlib.sha256((controller / local_name).read_bytes()).hexdigest()
            proc = run(ssh_argv(cfg, target, "sha256sum", "--", remote_name), check=False)
            actual = (proc.stdout or "").split(maxsplit=1)[0] if proc.returncode == 0 else ""
            if actual != expected:
                failures.append("remote deployed hash mismatch: %s" % remote_name)
        source_check = "git -C %s status --porcelain --untracked-files=no" % shlex.quote(
            cfg["AMPHORA_TARGET_ROOT"])
        proc = run(ssh_argv(cfg, target, source_check), check=False)
        if proc.returncode or (proc.stdout or "").strip():
            failures.append("remote canonical tracked tree is absent or dirty")
    if not os.access(cfg["AMPHORA_CLAUDE_BIN"], os.X_OK):
        failures.append("Claude binary not executable (authentication is a separate activation prerequisite)")
    if failures:
        for failure in failures:
            print("FAIL " + failure)
        return 1
    print("OK doctor: %s" % detail)
    return 0


def cmd_status(args, cfg):
    path = stop_path(cfg)
    print("state=PAUSED" if path.exists() else "state=UNSTOPPED")
    print("hard_stop=%s" % (path.read_text().splitlines()[0] if path.exists() else "absent"))
    local_text = read_cron(cfg)
    for name, text in (("xbabe1", local_text),):
        managed = [line for line in text.splitlines() if "amphora" in line.lower() and
                   any(word in line for word in ("hourly-loop", "mirror-log", "autocommit"))]
        print("%s_jobs=%s" % (name, json.dumps(managed)))
    target = cfg["AMPHORA_TARGET_HOST"]
    target_ok = True
    try:
        target_text = read_cron(cfg, target)
    except OperatorError:
        target_ok = False
        print("%s_jobs=UNREACHABLE" % target)
    else:
        managed = [line for line in target_text.splitlines() if "amphora" in line.lower() and
                   any(word in line for word in ("hourly-loop", "mirror-log", "autocommit"))]
        print("%s_jobs=%s" % (target, json.dumps(managed)))
    print("controller_processes=%d" % remote_process_count(cfg, None))
    return 0 if target_ok else 1


def seed_state(cfg):
    controller = Path(cfg["AMPHORA_CONTROLLER_ROOT"])
    state = Path(cfg["AMPHORA_STATE_ROOT"])
    state.mkdir(parents=True, exist_ok=True)
    (state / "state" / "locks").mkdir(parents=True, exist_ok=True)
    (state / "logs").mkdir(parents=True, exist_ok=True)
    for name in ("campaign.json", "data-acquisition-queue.jsonl"):
        destination = state / name
        if not destination.exists():
            shutil.copy2(controller / "bootstrap" / name, destination)


def deploy_guard(cfg):
    controller = Path(cfg["AMPHORA_CONTROLLER_ROOT"])
    host = cfg["AMPHORA_TARGET_HOST"]
    run(ssh_argv(cfg, host, "mkdir -p /home/ubuntu/.local/libexec /home/ubuntu/.config/amphora"))
    run(scp_argv(cfg, "-q", str(controller / "autocommit-guard.sh"),
                 "%s:/home/ubuntu/.local/libexec/amphora-autocommit-guard.sh" % host))
    run(scp_argv(cfg, "-q", str(controller / "policy" / "staged_file_policy.py"),
                 "%s:/home/ubuntu/.local/libexec/amphora-staged-file-policy.py" % host))
    run(scp_argv(cfg, "-q", str(controller / "config" / "mvp20-autocommit.env.example"),
                 "%s:/home/ubuntu/.config/amphora/mvp20-autocommit.env.example" % host))
    run(ssh_argv(cfg, host,
         "chmod 700 /home/ubuntu/.local/libexec/amphora-autocommit-guard.sh /home/ubuntu/.local/libexec/amphora-staged-file-policy.py; "
         "test -e /home/ubuntu/.config/amphora/mvp20-autocommit.env || "
         "cp /home/ubuntu/.config/amphora/mvp20-autocommit.env.example /home/ubuntu/.config/amphora/mvp20-autocommit.env; "
         "chmod 600 /home/ubuntu/.config/amphora/mvp20-autocommit.env"))


def protect_controller(controller):
    for path in sorted(controller.rglob("*"), reverse=True):
        mode = 0o555 if path.is_dir() or os.access(path, os.X_OK) else 0o444
        path.chmod(mode)
    controller.chmod(0o555)


def _controller_tree(cfg):
    return Path(cfg["AMPHORA_CONTROLLER_ROOT"])


def cmd_unprotect(args, cfg):
    """Restore owner write permission so git can update the controller tree.

    The deployed tree is mode 0555. Git updates a file by unlinking and recreating it
    inside its directory, so a read-only directory makes `git pull`, `git stash pop`,
    `git restore`, and `git clean` fail PART WAY THROUGH, leaving a half-applied
    checkout rather than a clean refusal. Unprotect first, pull, then protect again.
    """
    root = _controller_tree(cfg)
    if not root.is_dir():
        raise OperatorError("controller root is absent: %s" % root)
    if not args.apply:
        print("DRY-RUN: would restore owner write permission under %s" % root)
        return 0
    for path in [root, *root.rglob("*")]:
        mode = path.stat().st_mode & 0o7777
        path.chmod(mode | 0o200)
    print("unprotected %s -- re-protect with `amphora protect --apply` when done" % root)
    return 0


def cmd_protect(args, cfg):
    """Re-apply the read-only deployment protection and verify the hash manifest."""
    root = _controller_tree(cfg)
    if not root.is_dir():
        raise OperatorError("controller root is absent: %s" % root)
    if not args.apply:
        print("DRY-RUN: would verify the manifest and remove write permission under %s" % root)
        return 0
    ok, detail = verify_manifest(root)
    if not ok:
        raise OperatorError("refusing to protect an unverified controller: %s" % detail)
    for path in sorted(root.rglob("*"), reverse=True):
        path.chmod(path.stat().st_mode & ~0o222)
    root.chmod(root.stat().st_mode & ~0o222)
    ok, detail = verify_manifest(root)
    if not ok:
        raise OperatorError("controller changed while protection was applied: %s" % detail)
    print("protected %s; %s" % (root, detail))
    return 0


def cmd_install(args, cfg):
    if not args.apply:
        print("DRY-RUN: install requires --apply; jobs would remain disabled")
        return 0
    require_controller_host(cfg)
    if args.enable:
        if not args.tag:
            raise OperatorError("--enable requires --tag")
        require_matching_stop(cfg, args.tag)
    cfg_path = Path(cfg["AMPHORA_CONFIG_FILE"])
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    if not cfg_path.exists():
        example = Path(cfg["AMPHORA_CONTROLLER_ROOT"]) / "config" / "mvp20-cron.env.example"
        shutil.copy2(example, cfg_path)
    cfg_path.chmod(0o600)
    seed_state(cfg)
    deploy_guard(cfg)
    set_crons(cfg, args.enable, args.tag or "INSTALL-PAUSED", True)
    protect_controller(Path(cfg["AMPHORA_CONTROLLER_ROOT"]))
    print("installed; jobs=%s" % ("enabled" if args.enable else "disabled"))
    return 0


def cmd_test(args, cfg):
    controller = Path(cfg["AMPHORA_CONTROLLER_ROOT"])
    return run(["bash", str(controller / "tests" / "run.sh")], check=False, capture=False).returncode


def parser():
    p = argparse.ArgumentParser(prog="amphora")
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor").set_defaults(func=cmd_doctor)
    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("test").set_defaults(func=cmd_test)
    pause = sub.add_parser("pause")
    pause.add_argument("--tag", required=True, type=tag_arg)
    pause.add_argument("--apply", action="store_true")
    pause.set_defaults(func=cmd_pause)
    drain = sub.add_parser("drain")
    drain.add_argument("--timeout", type=int, default=120)
    drain.set_defaults(func=cmd_drain)
    resume = sub.add_parser("resume")
    resume.add_argument("--tag", required=True, type=tag_arg)
    resume.add_argument("--apply", action="store_true")
    resume.set_defaults(func=cmd_resume)
    unprotect = sub.add_parser("unprotect")
    unprotect.add_argument("--apply", action="store_true")
    unprotect.set_defaults(func=cmd_unprotect)
    protect = sub.add_parser("protect")
    protect.add_argument("--apply", action="store_true")
    protect.set_defaults(func=cmd_protect)
    install = sub.add_parser("install")
    install.add_argument("--apply", action="store_true")
    install.add_argument("--enable", action="store_true")
    install.add_argument("--tag", type=tag_arg)
    install.set_defaults(func=cmd_install)
    return p


def main():
    args = parser().parse_args()
    try:
        return args.func(args, config())
    except OperatorError as exc:
        print("ERROR: %s" % exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
