{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nomad-feature-hunt/v2.1/top-feature-record",
  "type": "object",
  "required": ["schema_version", "receipt_type", "feature_id", "target", "equation", "configuration", "domain", "physical_rationale", "novelty_proof", "validation_status", "strength_components", "strength"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "receipt_type": {"const": "top_feature_record"},
    "feature_id": {"type": "string"},
    "target": {"enum": ["formation_energy_ev_natom", "bandgap_energy_ev"]},
    "equation": {"type": "string"},
    "configuration": {"type": "object"},
    "domain": {"pattern": "^D(?:0[1-9]|10)$"},
    "physical_rationale": {"type": "string"},
    "novelty_proof": {"type": "object"},
    "validation_status": {"type": "string"},
    "strength_components": {"type": "object", "required": ["catboost_importance_percentile", "residual_correlation_percentile", "mutual_information_percentile"]},
    "strength": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
