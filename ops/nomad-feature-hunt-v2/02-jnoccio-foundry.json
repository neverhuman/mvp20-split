{
  "runbook_version": "2.0",
  "name": "jnoccio-foundry",
  "phases": ["design", "compilation"],
  "provider": "jnoccio",
  "model": "jnoccio-router",
  "workers": 20,
  "roles": 180,
  "attempts_per_role": 2,
  "prompt_limit_bytes": 12288,
  "output_limit_bytes": 20480,
  "canary": {"roles": 10, "first_pass_minimum": 9, "eventual_valid": 10},
  "command": "python -m nomad_feature_hunt.v2 design --run-id <run_id>"
}
